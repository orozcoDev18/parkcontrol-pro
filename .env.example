# ---------- apps/api ----------
# Copiar a apps/api/.env

# Postgres local: las dos cadenas son la misma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parkcontrol?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/parkcontrol?schema=public"

# Supabase (panel del proyecto > Connect > ORMs > Prisma):
# DATABASE_URL = Transaction pooler, puerto 6543, con ?pgbouncer=true
# DIRECT_URL   = Session pooler, puerto 5432 (la que usan db push y las migraciones)
# DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres"

PORT=3001
CORS_ORIGIN="http://localhost:3000"

# ---------- apps/web ----------
# Copiar a apps/web/.env.local
NEXT_PUBLIC_API_URL="http://localhost:3001"
